GEMINI_API_KEY=AQ.Ab8RN6KclH6bmRwvyR0aJEd7SO7JoXxyRU9HwlVvMXY6y1o1qA


# ---------------------------------------------------------------------------
# LLM — OpenAI (fallback + RAGAS evaluation judge)
# Get your key at: https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
OPENAI_API_KEY=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


# ---------------------------------------------------------------------------
# Langfuse — Observability & Tracing
# Get your keys at: https://cloud.langfuse.com → Project Settings → API Keys
# ---------------------------------------------------------------------------

LANGFUSE_SECRET_KEY="sk-lf-72a63ffb-5cb8-4af7-9fc2-8bd10a14ad75"
LANGFUSE_PUBLIC_KEY="pk-lf-99c89785-6acf-4c75-bcee-98eaa7ead165"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# ---------------------------------------------------------------------------
# Qdrant — Local Vector Store (Docker)
# Run locally with:
#   docker run -p 6333:6333 -p 6334:6334 qdrant/qdrant
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333

# Collection names for each pipeline (created automatically on first ingest)
QDRANT_NAIVE_COLLECTION=aman_naive
QDRANT_ADVANCED_COLLECTION=aman_advanced


# ---------------------------------------------------------------------------
# Embedding & Reranking Models  (downloaded from HuggingFace on first run)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# HuggingFace cache directory (optional — defaults to ~/.cache/huggingface)
# HF_HOME=D:/hf_cache


# ---------------------------------------------------------------------------
# Ingestion — Naive Pipeline Chunking
# ---------------------------------------------------------------------------
NAIVE_CHUNK_SIZE=512        # Characters per chunk
NAIVE_CHUNK_OVERLAP=64      # Overlap between consecutive chunks


# ---------------------------------------------------------------------------
# Ingestion — Advanced Pipeline Chunking
# ---------------------------------------------------------------------------
ADVANCED_MIN_CHUNK_SIZE=200   # Minimum paragraph size to keep (characters)
ADVANCED_MAX_CHUNK_SIZE=1200  # Maximum chunk size before forced split


# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=10           # Candidates fetched from vector store
RERANKER_TOP_N=4             # Documents kept after reranking


# ---------------------------------------------------------------------------
# LLM Generation
# ---------------------------------------------------------------------------
GEMINI_MODEL=gemini-2.5-flash-preview-05-20   # Gemini model identifier
OPENAI_MODEL=gpt-4o-mini            # OpenAI model used by RAGAS evaluator
LLM_TEMPERATURE=0.0                 # Deterministic answers for RAG
LLM_MAX_TOKENS=1024                 # Maximum tokens in generated answer


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
PDF_PATH=data/aman_internship_guide_2026.docx
