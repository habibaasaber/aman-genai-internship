# ============================================================
# GitHub MCP Chatbot — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ------------------------------------------------------------
# LLM — Primary: OpenAI
# ------------------------------------------------------------
# Your OpenAI API key. The primary model used is gpt-4o.
# To simulate a failure/fallback, set this to "invalid" and
# the system will retry 3x then fall back to Gemini.
OPENAI_API_KEY=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

# OpenAI model name (default: gpt-4o)
# Swap to gpt-4o-mini for lower cost during development.
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------
# LLM — Fallback: Google Gemini
# ------------------------------------------------------------
# Your Google AI Studio (Gemini) API key.
# Get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.Ab8RN6KclH6bmRwvyR0aJEd7SO7JoXxyRU9HwlVvMXY6y1o1qA

# Gemini model name (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------
# Retry & Backoff Configuration
# ------------------------------------------------------------
# Maximum number of retry attempts before giving up / falling back.
MAX_RETRIES=3

# Base delay in seconds for exponential backoff (delay = base * 2^attempt).
RETRY_BASE_DELAY=1.0

# Maximum delay cap in seconds between retries.
RETRY_MAX_DELAY=30.0

# ------------------------------------------------------------
# GitHub MCP Server
# ------------------------------------------------------------
# A GitHub Personal Access Token (classic) with these scopes:
#   repo, read:org, read:user
# Generate at: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...

# ------------------------------------------------------------
# Langfuse Observability
# ------------------------------------------------------------
# Get your keys at https://cloud.langfuse.com (free tier available).
# For self-hosted Langfuse, change LANGFUSE_HOST to your endpoint.
LANGFUSE_SECRET_KEY="sk-lf-72a63ffb-5cb8-4af7-9fc2-8bd10a14ad75"
LANGFUSE_PUBLIC_KEY="pk-lf-99c89785-6acf-4c75-bcee-98eaa7ead165"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Set to false to disable tracing (e.g., for offline development).
LANGFUSE_ENABLED=true

# ------------------------------------------------------------
# FastAPI Backend
# ------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

# Comma-separated list of allowed CORS origins (Chainlit's URL).
ALLOWED_ORIGINS=http://localhost:8000,http://chainlit:8000

# ------------------------------------------------------------
# Chainlit Frontend Authentication
# ------------------------------------------------------------
# Secret key for signing Chainlit auth tokens. CHANGE THIS in production.
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
CHAINLIT_AUTH_SECRET=please-change-this-to-a-strong-random-secret

# Comma-separated username:password pairs for the login page.
# Example: "admin:mypassword,alice:alice123"
CHAINLIT_USERS=admin:admin123,demo:demo456

# URL of the FastAPI backend (used by Chainlit to make API calls).
BACKEND_URL=http://localhost:8001
